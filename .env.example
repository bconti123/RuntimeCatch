# ─── Database ────────────────────────────────────────────────────────────────
#
# There are TWO database URLs in play, and which one applies depends on where
# the app process runs:
#
#   • Host database URL (this file): the app runs on your machine (`npm run dev`)
#     and reaches Postgres through the port the container publishes on the host.
#     Hostname is `localhost`, port is POSTGRES_HOST_PORT (default 5435).
#
#   • Docker-internal database URL: the app runs *inside* the compose network
#     (`docker compose up`). It reaches Postgres at the service name `postgres`
#     on the container's internal port 5432 — not localhost, not 5435. That URL
#     is hard-coded in docker-compose.yml for the `web` service and overrides
#     whatever DATABASE_URL is set here, so you don't need to change anything
#     to switch between the two modes.
#
# Used by Prisma for non-Docker local development. Keep the port in sync with
# POSTGRES_HOST_PORT below.
DATABASE_URL="postgresql://runtimecatch:runtimecatch@localhost:5435/runtimecatch?schema=public"

# ─── Docker Compose ──────────────────────────────────────────────────────────
#
# Host-side port mappings for `docker compose up`. The containers always listen
# on their standard internal ports (web: 3000, postgres: 5432); only the host
# side is remapped, so changing these never affects the Docker-internal URL.

# Host port the web app is published on → http://localhost:${WEB_PORT}
WEB_PORT=3000

# Host port Postgres is published on. 5435 avoids clashing with a system
# Postgres install on 5432-5434. If you change this, update DATABASE_URL above.
POSTGRES_HOST_PORT=5435

# ─── Production ──────────────────────────────────────────────────────────────
#
# These variables only apply when deploying (e.g. to Railway). They are not
# needed for local development and the values below are illustrative only —
# never check real production secrets into the repo.

# Set automatically by Railway when you attach a Postgres plugin. Pin it on
# the web service using the reference variable ${{Postgres.DATABASE_URL}} so
# it tracks the database without a manual copy.
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Set automatically by Railway. Locally, leaving this unset defaults to
# development; explicitly setting NODE_ENV=production enables the secure
# session cookie flag and Prisma's quieter logging.
# NODE_ENV=production

# Forward-compat secret reserved for signing future session/CSRF tokens.
# The current credentials flow uses opaque session IDs stored in Postgres
# and does not consume this value, but the variable is wired through the
# Docker setup so deployments can set it once now and avoid a config change
# later. Generate with: `openssl rand -hex 32`.
# SESSION_SECRET="replace-with-a-32-byte-random-hex-string"
