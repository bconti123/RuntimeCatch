// RuntimeCatch — observability platform schema
// PostgreSQL via Prisma 7

generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  OWNER
}

enum Environment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

enum ServiceStatus {
  HEALTHY
  DEGRADED
  DOWN
}

enum Severity {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum EventCategory {
  RUNTIME_ERROR
  API_LATENCY
  PLAYBACK_ERROR
  DEPLOYMENT
  DATABASE
  NETWORK
  AUTH
}

enum IssueStatus {
  OPEN
  RESOLVED
  MUTED
  IGNORED
}

enum AlertStatus {
  TRIGGERED
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())

  projects Project[]
  sessions Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  services Service[]
  apiKeys  ApiKey[]

  @@index([ownerId])
}

model ApiKey {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([projectId])
}

model Service {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  environment Environment
  status      ServiceStatus @default(HEALTHY)
  createdAt   DateTime      @default(now())

  events      RuntimeEvent[]
  alerts      Alert[]
  deployments Deployment[]

  @@unique([projectId, name])
  @@index([projectId])
}

model RuntimeEvent {
  id          String        @id @default(cuid())
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  severity    Severity
  category    EventCategory
  message     String
  stackTrace  String?
  metadata    Json?
  fingerprint String
  resolved    Boolean       @default(false)
  createdAt   DateTime      @default(now())

  issueId String?
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([serviceId, createdAt])
  @@index([fingerprint])
  @@index([category, createdAt])
}

model Issue {
  id              String      @id @default(cuid())
  title           String
  fingerprint     String      @unique
  severity        Severity
  status          IssueStatus @default(OPEN)
  occurrenceCount Int         @default(1)
  firstSeenAt     DateTime    @default(now())
  lastSeenAt      DateTime    @default(now())

  events RuntimeEvent[]

  @@index([status, lastSeenAt])
}

model Alert {
  id          String      @id @default(cuid())
  serviceId   String
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title       String
  severity    Severity
  status      AlertStatus @default(TRIGGERED)
  triggeredAt DateTime    @default(now())
  resolvedAt  DateTime?

  @@index([serviceId, status])
  @@index([status, triggeredAt])
}

model Deployment {
  id          String      @id @default(cuid())
  serviceId   String
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  version     String
  commitSha   String
  environment Environment
  deployedAt  DateTime    @default(now())

  @@index([serviceId, deployedAt])
}
