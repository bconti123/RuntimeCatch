# RuntimeCatch instance you want to report to.
RUNTIMECATCH_API_URL=http://localhost:3000

# Project API key (rc_live_…). Create one at /settings/api-keys in RuntimeCatch.
# The seeded local demo key is shown below for development only.
RUNTIMECATCH_API_KEY=rc_live_demo_key_for_local_testing_only

# Must match a service that already exists in the API key's project.
RUNTIMECATCH_SERVICE=playback-service

# Free-form label stamped into every event's metadata.
RUNTIMECATCH_ENVIRONMENT=development
